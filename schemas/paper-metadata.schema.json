{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Paper Metadata Schema",
  "description": "Esquema de validación para paper/metadata.yaml — especificación del manuscrito científico",
  "type": "object",
  "required": ["title", "authors", "journal", "citation_style", "language"],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 5,
      "description": "Título del paper en idioma original"
    },
    "title_en": {
      "type": "string",
      "description": "Título en inglés (requerido por algunas revistas)"
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "affiliation": { "type": "string" },
          "email": { "type": "string" },
          "orcid": { "type": "string" }
        }
      },
      "description": "Lista de autores con metadatos"
    },
    "journal": {
      "type": "string",
      "minLength": 1,
      "description": "Nombre de la revista objetivo"
    },
    "journal_issue": {
      "type": ["integer", "string"],
      "description": "Número de la edición"
    },
    "publisher": {
      "type": "string"
    },
    "submission_window": {
      "type": "string",
      "description": "Ventana de envío (e.g. '1-31 agosto 2026')"
    },
    "status": {
      "type": "string",
      "enum": ["draft", "review", "submitted", "accepted", "published"],
      "description": "Estado actual del manuscrito"
    },
    "language": {
      "type": "string",
      "minLength": 2,
      "maxLength": 5,
      "description": "Código de idioma principal (e.g. 'es', 'en')"
    },
    "additional_languages": {
      "type": "array",
      "items": { "type": "string" }
    },
    "citation_style": {
      "type": "string",
      "enum": ["chicago-author-date", "chicago-notes", "apa", "ieee", "vancouver", "harvard", "mla"],
      "description": "Estilo de citación requerido por la revista"
    },
    "format": {
      "type": "object",
      "properties": {
        "font": { "type": "string" },
        "font_size": { "type": ["integer", "number"] },
        "line_spacing": { "type": ["number", "string"] },
        "page_size": { "type": "string" },
        "margins": { "type": "string" },
        "footnote_font_size": { "type": ["integer", "number"] },
        "footnote_spacing": { "type": "string" }
      },
      "description": "Formato de manuscrito requerido por la revista"
    },
    "word_limits": {
      "type": "object",
      "properties": {
        "total_min": { "type": "integer", "minimum": 0 },
        "total_max": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": true,
      "description": "Límites de palabras total y por sección"
    },
    "abstract_requirements": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Requisitos del resumen según la revista"
    },
    "keywords_es": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Palabras clave en español"
    },
    "keywords_en": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Palabras clave en inglés"
    },
    "keywords_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "call_for_papers": {
      "type": "object",
      "properties": {
        "theme": { "type": "string" },
        "axes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["file", "name"],
        "properties": {
          "file": { "type": "string" },
          "name": { "type": "string" },
          "target_words": { "type": "integer", "minimum": 0 }
        }
      },
      "description": "Orden y configuración de secciones del manuscrito"
    },
    "editorial_notes": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Notas editoriales específicas de la revista"
    }
  },
  "additionalProperties": true
}
